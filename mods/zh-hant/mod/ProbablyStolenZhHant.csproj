<Project Sdk="Microsoft.NET.Sdk">

  <!-- 官方格式的 mod（正式版 1.0 起，遊戲自己的 mod 載入器載入，不需要 MelonLoader）。
       編譯時參考正式版遊戲的 Probably Stolen_Data\Managed（Mono 組件，只讀、不附進 mod）。
       遊戲不在預設位置時：dotnet build -p:GameDir="遊戲資料夾"
       目標框架 net48：遊戲是 Unity 2021.3 的 Mono（.NET 4.x），輸出的組件只參考 mscorlib、System、System.Core 與 Managed 裡的組件；
       遊戲的掃描會拒絕參考了 Managed 以外組件的 mod（tools/check.py 的「官方掃描」離線確認）。 -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ProbablyStolenZhHant</AssemblyName>
    <RootNamespace>ProbablyStolenZhHant</RootNamespace>
    <!-- 版本號只放這裡：組件版本、manifest.xml 的 ModVersion、打包檔名都從這裡來（tools/modkit.py 的 csproj_version） -->
    <Version>2.4.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Probably Stolen</GameDir>
    <ManagedDir>$(GameDir)\Probably Stolen_Data\Managed</ManagedDir>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="verify/**" />
    <Reference Include="$(ManagedDir)\0Harmony.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.TextCoreFontEngineModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.Localization.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.ResourceManager.dll" Private="false" />
  </ItemGroup>

</Project>
