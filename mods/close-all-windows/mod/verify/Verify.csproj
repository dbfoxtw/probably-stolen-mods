<Project Sdk="Microsoft.NET.Sdk">

  <!-- 離線測試：一鍵關閉的分組規則、鎖的資料檔（不用開遊戲、不需要 MelonLoader）。執行方式見 Program.cs 開頭 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\Rules.cs" Link="Rules.cs" />
    <Compile Include="..\src\LockStore.cs" Link="LockStore.cs" />
  </ItemGroup>

</Project>
