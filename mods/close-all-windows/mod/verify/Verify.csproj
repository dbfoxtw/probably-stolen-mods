<Project Sdk="Microsoft.NET.Sdk">

  <!-- 離線測試：一鍵關閉的分組規則、鎖的資料檔（不用開遊戲、不需要遊戲的組件）。執行方式見 Program.cs 開頭 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\Rules.cs" Link="Rules.cs" />
    <Compile Include="..\src\LockStore.cs" Link="LockStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- LockStore 用的 JSON：mod 在遊戲裡用遊戲自帶的 Newtonsoft.Json（組件版本 13.0.0.0），這裡用同一個大版本的 NuGet 套件 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
