<Project Sdk="Microsoft.NET.Sdk">

  <!-- 離線測試：標籤的數字格式、分段、掃描結果的解析、行序、顏色與開關、每台機器的判斷（MachineLogic）、效能量測的模式與統計（PerfStats）、資訊框與說明的字（1.2.0 起讀 public/Localization 的 csv）與挑語言（LocPick）（不用開遊戲、不需要遊戲的組件）。執行方式見 Program.cs 開頭 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\Rules.cs" Link="Rules.cs" />
    <!-- Strings、Tips 取字用 Loc：這裡是 verify 自己的假 Loc（FakeLoc.cs，讀 public/Localization 的 csv），挑法的部分用 mod 的 LocPick -->
    <Compile Include="..\src\Strings.cs" Link="Strings.cs" />
    <Compile Include="..\src\Tips.cs" Link="Tips.cs" />
    <Compile Include="..\src\LocPick.cs" Link="LocPick.cs" />
    <!-- Loc 找繁中 mod 用的「找過就記住」（不碰遊戲型別的那一半） -->
    <Compile Include="..\src\LookupOnce.cs" Link="LookupOnce.cs" />
    <Compile Include="..\src\MachineLogic.cs" Link="MachineLogic.cs" />
    <Compile Include="..\src\PerfStats.cs" Link="PerfStats.cs" />
  </ItemGroup>

</Project>
